}

function exportJSON(){
  const answers = readAnswers();
  const {axisScores, overall, answered} = computeScores(answers);
  const must = AXES.reduce((acc,a)=> acc + a.subaxes.length, 0);

  const payload = {
    meta: {
      tool: "Auto-diagnostic SBO",
      scale: "1 (faible) -> 3 (élevée)",
      answered: `${answered}/${must}`,
      exportedAt: new Date().toISOString()
    },
    answers,
    axisScores,
    overallScore: overall,
    overallLevel: levelFromScore(overall)
  };

  const blob = new Blob([JSON.stringify(payload, null, 2)], {type:"application/json"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "resultats-sbo.json";
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}

